# Runtime data (SQLite DB, uploaded audio)
data/
*.db
*.db-wal
*.db-shm

# Local env
.env

# TLS material for the reverse proxy — never commit private keys/certs.
deploy/certs/*
!deploy/certs/README.txt

# Docker secret files (SECRET_KEY, ADMIN_PASSWORD, OIDC_CLIENT_SECRET).
secrets/*
!secrets/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
