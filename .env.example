# Copy to .env and fill in. docker-compose reads this automatically.
#
# SECRETS: when running via docker compose, the three sensitive values —
# SECRET_KEY, ADMIN_PASSWORD, OIDC_CLIENT_SECRET — are NOT set here. They live in
# ./secrets/ as Docker secret files; create them once with:
#     ./deploy/init-secrets.sh
# (They are deliberately omitted below: an env var would override the secret
# file.) The plain SECRET_KEY/ADMIN_PASSWORD/OIDC_CLIENT_SECRET entries are only
# needed if you run the app directly with uvicorn instead of Docker — in that
# case uncomment and set them here.
#   SECRET_KEY=            # e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
#   ADMIN_PASSWORD=
#   OIDC_CLIENT_SECRET=

# First-run admin username (created on startup; its password is a secret file).
ADMIN_USER=marco

# Upstreams on the link machine (Phase 2+). STT defaults to LLM_BASE_URL.
LLM_BASE_URL=http://link:8080/v1
LLM_DEFAULT_MODEL=qwen2.5-32b
LLM_CONTEXT_TOKENS=32768
STT_BASE_URL=http://link:8080/v1
STT_MODEL=whisper-large-v3-turbo
# Transcription source language. Leave empty to derive it from each user's
# interface-language preference (Dutch UI -> Dutch transcript; English ->
# autodetect). Use "auto" to always autodetect, or an ISO-639-1 code
# (e.g. nl, en) to pin one language for everyone.
STT_LANGUAGE=

# Uploads / cookies
MAX_UPLOAD_MB=500
# Set true when serving over HTTPS (i.e. behind the Caddy TLS proxy) so the
# session cookie carries the Secure flag.
COOKIE_SECURE=false

# --- Internal publishing: TLS reverse proxy -----------------------------------
# Hostname colleagues browse to (office/VPN DNS -> this host). Used by Caddy and
# must match the host in OIDC_REDIRECT_URL and the Entra app's redirect URI.
# Bring up the proxy with:  docker compose --profile tls up -d --build
KNOWTS_DOMAIN=knowts.internal

# --- Microsoft Entra ID (Azure AD) SSO ----------------------------------------
# Full setup (app registration, redirect URI, secret) is in
# deploy/INTERNAL-DEPLOYMENT.md. Leave OIDC_ENABLED=false to keep local login
# only. When enabled, the login page adds a "Sign in with Microsoft" button.
OIDC_ENABLED=false
# Directory (tenant) ID — a GUID from the Entra app's Overview page.
OIDC_TENANT_ID=
# Application (client) ID from the Entra app's Overview page. (The client
# *secret* is a Docker secret — see ./secrets/ and deploy/init-secrets.sh.)
OIDC_CLIENT_ID=
# Must exactly equal the redirect URI registered on the Entra app.
OIDC_REDIRECT_URL=https://knowts.internal/auth/sso/callback
# Comma-separated emails that should be admins on SSO login (others -> member,
# promote later via the Users admin page).
OIDC_ADMIN_EMAILS=marco@example.com
# Optional: only accept accounts in this email domain. Blank = any the tenant returns.
OIDC_ALLOWED_EMAIL_DOMAIN=
# Keep local username/password login working alongside SSO (recommended as a
# break-glass path). Set false to hide the local form (still reachable at
# /login?local=1 for the bootstrap admin).
LOCAL_LOGIN_ENABLED=true

# Speaker diarization (optional, off by default). CPU/ONNX via sherpa-onnx —
# no GPU, no HuggingFace token. Requires `pip install -r requirements-diarization.txt`
# plus the two non-gated ONNX models (see README). Leave DIARIZATION_ENABLED
# unset/false to keep transcripts unlabelled.
DIARIZATION_ENABLED=false
DIARIZATION_SEGMENTATION_MODEL=/data/models/diarization/segmentation.onnx
DIARIZATION_EMBEDDING_MODEL=/data/models/diarization/embedding.onnx
# Set if you know the speaker count; 0 = cluster automatically via the threshold.
DIARIZATION_NUM_SPEAKERS=0
DIARIZATION_CLUSTER_THRESHOLD=0.5
DIARIZATION_NUM_THREADS=1
