# Copy to .env and fill in. docker-compose reads this automatically.

# Session cookie signing key — generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# First-run admin (created on startup if it doesn't exist yet).
ADMIN_USER=marco
ADMIN_PASSWORD=change-me

# Upstreams on the link machine (Phase 2+). STT defaults to LLM_BASE_URL.
LLM_BASE_URL=http://link:8080/v1
LLM_DEFAULT_MODEL=qwen2.5-32b
LLM_CONTEXT_TOKENS=32768
STT_BASE_URL=http://link:8080/v1
STT_MODEL=whisper-large-v3-turbo
# Transcription source language. Leave empty to derive it from each user's
# interface-language preference (Dutch UI -> Dutch transcript; English ->
# autodetect). Use "auto" to always autodetect, or an ISO-639-1 code
# (e.g. nl, en) to pin one language for everyone.
STT_LANGUAGE=

# Uploads / cookies
MAX_UPLOAD_MB=500
# Set true when serving over HTTPS.
COOKIE_SECURE=false

# Speaker diarization (optional, off by default). CPU/ONNX via sherpa-onnx —
# no GPU, no HuggingFace token. Requires `pip install -r requirements-diarization.txt`
# plus the two non-gated ONNX models (see README). Leave DIARIZATION_ENABLED
# unset/false to keep transcripts unlabelled.
DIARIZATION_ENABLED=false
DIARIZATION_SEGMENTATION_MODEL=/data/models/diarization/segmentation.onnx
DIARIZATION_EMBEDDING_MODEL=/data/models/diarization/embedding.onnx
# Set if you know the speaker count; 0 = cluster automatically via the threshold.
DIARIZATION_NUM_SPEAKERS=0
DIARIZATION_CLUSTER_THRESHOLD=0.5
DIARIZATION_NUM_THREADS=1
